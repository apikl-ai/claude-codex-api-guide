// 放在 ~/.config/opencode/opencode.jsonc（全局）或项目根目录 opencode.jsonc。
// 适用 OpenCode 1.x 正式版（provider / npm / options 写法）。
// 密钥从环境变量 APIKL_API_KEY 读取：export APIKL_API_KEY=sk-...
// 用法：opencode -m apikl-claude/claude-sonnet-5-5   或   opencode -m apikl-openai/gpt-5.6-sol
{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    // Claude 走 Anthropic 原生协议，能用上提示缓存
    "apikl-claude": {
      "npm": "@ai-sdk/anthropic",
      "name": "apikl Claude",
      "options": { "baseURL": "https://apikl.ai/v1", "apiKey": "{env:APIKL_API_KEY}" },
      "models": { "claude-sonnet-5-5": { "name": "Claude Sonnet 5.5" } }
    },
    // GPT 等 OpenAI 兼容模型
    "apikl-openai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "apikl OpenAI",
      "options": { "baseURL": "https://apikl.ai/v1", "apiKey": "{env:APIKL_API_KEY}" },
      "models": { "gpt-5.6-sol": { "name": "GPT-5.6 Sol" } }
    }
  }
}
